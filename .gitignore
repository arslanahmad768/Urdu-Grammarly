# Python bytecode and virtual environments
__pycache__/
*.py[cod]
.venv/
venv/
env/

# Django local data and build output
*.sqlite3
/media/
/staticfiles/
*.log

# Environment and secrets
.env
.env.*

# Node / React (frontend has its own .gitignore as well)
node_modules/
/frontend/build/
/frontend/coverage/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editors and OS files
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local-only notes (e.g. PR descriptions drafted before opening a pull request)
PR_DESCRIPTION.md
